# =====================================================
# 期货预测平台 - 环境变量模板（提交到 git）
# 复制为 .env 并填写真实值，.env 已在 .gitignore 中
# =====================================================

# --- tqsdk 天勤账号（用户提供，用于行情补缺与二次比对）---
TQSDK_PHONE=replace_me
TQSDK_PASSWORD=replace_me

# --- TimescaleDB（M1 起）---
POSTGRES_USER=futures
POSTGRES_PASSWORD=replace_me_strong_password
POSTGRES_DB=futures
POSTGRES_PORT=5432
POSTGRES_HOST=timescaledb

# --- 对接鉴权（简报引擎 X-API-Key，M5 前定稿）---
INTEGRATION_API_KEY=replace_me

# --- 采集/校准参数（与 PRD §4.1/§4.2 对应，可在 config.yaml 覆盖）---
INGEST_CRON_1=12:00
INGEST_CRON_2=16:00
INGEST_CRON_3=08:00
TQSDK_PRICE_DIFF_THRESHOLD_PCT=0.5
TQSDK_TIMEOUT_SEC=15
TQSDK_MAX_RETRIES=2

# --- 历史回补起始（PRD §11.2 ⑮）---
HISTORY_START_DATE=2015-01-01

# --- Web / API ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- 时区 ---
TZ=Asia/Shanghai