# =====================================================
# 一次性调试脚本（_ 前缀 = 排障用，非生产链路，勿入库）
# 生产脚本一律不带下划线前缀（如 scripts/adjust_bars.py）。
# 注：_patch_*.py 为「容器内直接改源码」的补丁脚本，属违规操作的历史遗留，
#     应改用 git 提交 + 重建镜像，故同样不入库。
# =====================================================
scripts/_*.py
# 根目录一次性排障脚本同样不入库（2026-06 补：反复出现 _xxx.py 忘记清理，
#   污染 git status 并有被误提交的风险）。
/_*.py
/_*.sh

# 临时 compose override（以 root 跑 api/scheduler，绕过 qhyc_logs/qhyc_runtime
# 卷属主问题）。属**临时兜底**，正确修法是把卷 chown 成 uid 10001 后删除本文件，
# 故不入库，避免长期以 root 跑服务。
docker-compose.override.rootfix.yml

# 因子配对分析产物（可由 factor_pairs_ic.py 重跑生成）
scripts/factor_pairs_out/

# =====================================================
# 数据导入目录（本地 bind 进容器 /app/imports，不入库）
# =====================================================
imports/

# 根目录一次性排查产物
/_db_*.py
/_db_*.txt
/_inv.py
/_fix_and_audit.py
/$null
dce_member_position_rank.csv

# =====================================================
# 本地备份 / 运行日志（含 pg_dump 全备，体积 GB 级，禁止入库）
# =====================================================
backups/
# 本地实验产物(273MB pkl/csv.gz)，勿入库
docs/_swing_out/

# =====================================================
# 过程文档归档（本地保留，不入 git、不驻云端）
# 仅 docs/期货量化交易系统PRD.md 作为唯一权威需求文档入库
# =====================================================
docs/archive/

# =====================================================
# 生产热修复时留下的备份副本（2026-11-07/08 事故期间手工生成）
# 例：app/core/config.py.bak_p0_20261107 —— 这些是「改前快照」，不是源码。
# 不入 git 但**也不删**（回滚还要用），只让 git status 恢复干净：
# 生产上 git status 必须为空是发布脚本 publish.py 的硬性前置条件，
# 一堆 .bak 常驻会让它每次都要人肉确认「这些脏文件是不是又绕过通道了」。
# =====================================================
*.bak
*.bak_*
*.bak_*_*

# 脚本抓取/生成的费率快照（db/seed 下由 rebuild_dict_from_akshare.py /
# sync_cost_from_exchange.py 运行时写入；本地没有、生产有，属生成物不入库）
db/seed/ak_futures_fees_variety.csv
db/seed/czce_official_fees.csv
